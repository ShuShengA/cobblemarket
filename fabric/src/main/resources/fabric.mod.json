{
	"schemaVersion": 1,
	"id": "cobblemarket",
	"version": "${version}",
	"name": "CobbleMarket",
	"description": "A player-to-player trading market for Cobblemon: buy and sell Pokémon and items, with configurable listing fees, per-player bans, transaction history, expired listing returns, and optional currency support for Cobblemon Economy / CobbleDollars / Impactor / item currency.\n面向 Cobblemon 服务器的玩家交易市场：支持精灵与物品挂单买卖、可配置手续费、封禁、交易历史、过期退回，支持 Cobblemon Economy / CobbleDollars / Impactor / 物品（虚拟货币或物品货币）。",
	"authors": [
		"Shu_ShengA"
	],
	"contact": {
		"homepage": "https://shushenga.github.io/CobbleMarket-Website/",
		"sources": "https://github.com/ShuShengA/cobblemarket",
		"issues": "https://github.com/ShuShengA/cobblemarket/issues"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/cobblemarket"
			}
		}
	},
	"license": "GPL-3.0-only",
	"icon": "assets/cobblemarket/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.shusheng.cobblemarket.CobbleMarketFabric",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.shusheng.cobblemarket.client.CobbleMarketClientFabric",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "com.shusheng.cobblemarket.CobbleMarketDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"cobblemarket.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"cobblemon": ">=1.8.0 <1.9.0"
	}
}
